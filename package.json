{
  "type": "module",
  "name": "final-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run copy:html",
    "copy:html": "find src -type f -name \"*.html\" -exec sh -c 'mkdir -p \"$(dirname \"dist/${1#src/}\")\" && cp \"$1\" \"dist/${1#src/}\"' _ {} \\;",
    "dev": "npm run copy:html && concurrently \"tsc --watch\" \"chokidar 'src/**/*.html' -c 'npm run copy:html'\" \"live-server ./dist\"",
    "serve": "live-server ./dist",
    "start": "npm run build && npm run serve",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uabdirasul/final-project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/uabdirasul/final-project/issues"
  },
  "homepage": "https://github.com/uabdirasul/final-project#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "live-server": "^1.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
